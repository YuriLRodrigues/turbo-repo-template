{
  "name": "web",
  "version": "0.1.0",
  "description": "The web app: Next.js static export, signed-in shell, auth screens and the notes example, on @workspace/api-client.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3501",
    "build": "next build && node tooling/fix-export.mjs",
    "preview": "node tooling/serve-out.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node tooling/screenshots.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "@workspace/api-client": "*",
    "@workspace/ui": "*",
    "@workspace/utils": "*",
    "geist": "1.9.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@workspace/config": "*",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
