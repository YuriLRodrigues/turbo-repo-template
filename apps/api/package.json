{
  "name": "api",
  "version": "0.1.0",
  "description": "The API: NestJS + Drizzle with Clean Architecture (identity and the notes example).",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/infra/database/migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit --project integration",
    "test:cov": "vitest run --project unit --project integration --coverage",
    "openapi": "node tooling/export-openapi.mjs",
    "docs:openapi": "nest build && node tooling/export-openapi.mjs"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run --project unit --project integration --passWithNoTests"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "1.0.0-rc.5",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "@workspace/config": "*",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
