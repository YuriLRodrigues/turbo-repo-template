# Optional in development: `npm run dev -w api` works without any .env (embedded database, generated JWT secret,
# e-mails written to the log). Copy to .env to change something. Every variable is validated by
# src/infra/env/env.ts (zod) before the app starts; a variable left empty is the same as a variable that is not there.

NODE_ENV=development
APP_NAME=App
PORT=3500

# ── Database ────────────────────────────────────────────────────────────────────────────────────────────────
# Without DATABASE_URL (development only) the API starts an embedded PGlite, keeps its files in apps/api/.pglite/data
# and applies the migrations by itself. With it, the API uses that Postgres (`docker compose up -d` in apps/api gives
# you the one below; then `npm run db:migrate -w api`). Required outside development.
# DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_POOL_MAX=10
# Embedded database only:
# PGLITE_DATA_DIR=memory://   # a folder, or memory:// to keep nothing (default: apps/api/.pglite/data)
# PGLITE_PORT=0               # the local port it listens on; 0 picks a free one

# ── Auth ────────────────────────────────────────────────────────────────────────────────────────────────────
# At least 32 characters. In development a missing one is generated once and kept in apps/api/.pglite/dev-jwt-secret.
# Required outside development. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=900
# SameSite of the refresh cookie: lax | strict | none. `none` (web and API on different sites) also forces Secure.
AUTH_COOKIE_SAME_SITE=lax

# ── HTTP ────────────────────────────────────────────────────────────────────────────────────────────────────
# Who may call the API from a browser, with credentials. Comma separated.
CORS_ORIGINS=http://localhost:3501
# How many reverse proxies sit in front of the API (the client IP then comes from X-Forwarded-For).
TRUST_PROXY_HOPS=0
# Requests per window, per IP and per route, on the routes that need no token (sign-in, sign-up, refresh...).
PUBLIC_RATE_LIMIT=30
PUBLIC_RATE_WINDOW_SECONDS=60

# ── E-mail ──────────────────────────────────────────────────────────────────────────────────────────────────
# The address of the web app: the links of the e-mails point to it.
WEB_APP_URL=http://localhost:3501
MAIL_FROM=App <no-reply@example.com>
# With SMTP_HOST the e-mails go out by SMTP; without it they are written to the log. Required in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=

# ── Logger (all optional) ───────────────────────────────────────────────────────────────────────────────────
# LOG_FORMAT=pretty        # pretty | json (default: json in production)
# LOG_LEVEL=info           # debug | info | warn | error
# LOG_BRAND=APP            # the name in the big letters of the banner (default: APP_NAME in capitals)
# LOG_BANNER=on            # on | off
# LOG_REQUESTS=on          # on | off: one line per HTTP request
# LOG_BACKGROUND=auto      # auto | dark | light: which palette the terminal gets
