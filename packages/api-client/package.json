{
  "name": "@workspace/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "The typed client of the API: generated by Orval from apps/api/openapi.json, over a fetch mutator that renews the session (refresh-and-retry, serialized across tabs with Web Locks).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./gen/*": "./src/gen/*.ts",
    "./models": "./src/gen/models/index.ts"
  },
  "scripts": {
    "gen": "orval --config orval.config.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@workspace/config": "*",
    "eslint": "10.14.0",
    "orval": "8.47.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
